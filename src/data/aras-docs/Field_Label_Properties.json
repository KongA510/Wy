{
  "title": "字段标签属性",
  "html": "<html><head></head><body><div>\n  <h1>字段标签属性</h1>\n  <table cellspacing=\"0\" class=\"Aras_Blue\" style=\"left: 0px; top: 71px;\" width=\"957\">\n    <colgroup>\n      <col style=\"width: 19.473%;\">\n      <col style=\"width: 80.527%;\">\n    </colgroup>\n    <tbody>\n      <tr class=\"t1st\">\n        <td style=\"border: Solid 1px #c0c0c0;\">\n          <p class=\"Table_header\">属性</p>\n        </td>\n        <td style=\"border-top: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_header\">说明</p>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">标签</p>\n        </td>\n        <td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">用户在表单上看到的标签。这是一个多语言字符串。<a href=\"#\" style=\"font-size: 10pt;\" class=\"internal-doc-link\">参见国际化</a></p>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">字体</p>\n        </td>\n        <td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">要显示的字体</p>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">标签位置</p>\n        </td>\n        <td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">标签相对于值框的放置位置</p>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">字体粗细</p>\n        </td>\n        <td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">粗体或常规</p>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">文本对齐</p>\n        </td>\n        <td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">左对齐、右对齐或居中</p>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">字体大小</p>\n        </td>\n        <td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">以磅为单位</p>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">字体颜色</p>\n        </td>\n        <td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">通过颜色选择器选择</p>\n        </td>\n      </tr>\n    </tbody>\n  </table>\n\n</div></body></html>",
  "sourceFile": "Field_Label_Properties.htm"
}