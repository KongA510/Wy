  "html": "<html><head></head><body><div>\n<h1>表单属性</h1>\n<table class=\"Aras_Blue\" cellspacing=\"0\" width=\"70.833%\">\n<colgroup><col style=\"width: 24.136%;\">\n<col style=\"width: 14.725%;\">\n<col style=\"width: 61.139%;\">\n</colgroup><tbody><tr class=\"t1st\">\n<td style=\"border: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\">属性名称</p>\n</td>\n<td style=\"border-top: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\">必填</p>\n</td>\n<td style=\"border-top: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\">描述</p>\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-weight: bold;\">Name</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\">Y</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\">表单的名称</p>\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-weight: bold;\">Description</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\">N</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\">表单的描述</p>\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-weight: bold;\">Width</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\">N</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\">表单打开时的宽度</p>\n</t