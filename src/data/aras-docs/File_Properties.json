{
  "title": "文件属性",
  "html": "<html><head></head><body><div>\n  <h1>文件属性</h1>\n  <table cellspacing=\"0\" class=\"Aras_Blue\" style=\"border: Solid 1px #c0c0c0; left: 0px; top: 29px;\" width=\"965\">\n    <colgroup>\n      <col style=\"width: 25.022%;\">\n      <col style=\"width: 16.095%;\">\n      <col style=\"width: 58.883%;\">\n    </colgroup>\n    <tbody>\n      <tr class=\"t1st\">\n        <td style=\"border: Solid 1px #c0c0c0;\">\n          <p class=\"Table_header\" style=\"color: #808080;\">属性名称</p>\n        </td>\n        <td style=\"border-top: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_header\" style=\"color: #808080;\">必填</p>\n        </td>\n        <td style=\"border-top: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_header\" style=\"color: #808080;\">描述</p>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\" style=\"font-weight: bold;\">文件名</p>\n        </td>\n        <td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">是</p>\n        </td>\n        <td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">存储在保险库中的文件名称</p>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\" style=\"font-weight: bold;\">文件类型</p>\n        </td>\n        <td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">是</p>\n        </td>\n        <td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">由文件扩展名标识的文件类型</p>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\" style=\"font-weight: bold;\">文件大小</p>\n        </td>\n        <td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">是</p>\n        </td>\n        <td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">文件大小（以字节为单位）</p>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\" style=\"font-weight: bold;\">签出路径</p>\n        </td>\n        <td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">否</p>\n        </td>\n        <td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">文件签出用于编辑时，本地副本的位置</p>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\" style=\"font-weight: bold;\">备注</p>\n        </td>\n        <td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">否</p>\n        </td>\n        <td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">备注字段</p>\n        </td>\n      </tr>\n    </tbody>\n  </table>\n\n</div></body></html>",
  "sourceFile": "File_Properties.htm"
}