{
  "title": "表单字段",
  "html": "<html><head></head><body><div>\n<h1>表单字段</h1>\n<p class=\"Content_body\">以下字段可在表单中使用：</p>\n<table class=\"Aras_Blue\" cellspacing=\"0\" width=\"70.175%\">\n<colgroup><col style=\"width: 30.056%;\">\n<col style=\"width: 48.939%;\">\n<col style=\"width: 21.005%;\">\n</colgroup><tbody><tr class=\"t1st\">\n<td style=\"border: Solid 1px #c0c0c0;\">\n<p class=\"Table_header\">字段类型</p>\n</td>\n<td style=\"border-top: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_header\">描述</p>\n</td>\n<td style=\"border-top: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_header\">快捷访问按钮</p>\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">Text</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">标准文本字段</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\"><img src=\"/aras-images/image3.gif\" alt=\"\" style=\"border: none;\" border=\"0\"></p>\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">Password</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">文本通过 MD5 加密隐藏的文本字段</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\"><img src=\"/aras-images/image4.gif\" alt=\"\" style=\"border: none;\" border=\"0\"></p>\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">Text Area</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">带滚动条的标准文本区域</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\"><img src=\"/aras-images/image5.gif\" alt=\"\" style=\"border: none;\" border=\"0\"></p>\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">Check box</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">标准复选框</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\"><img src=\"/aras-images/image22.gif\" alt=\"\" style=\"border: none;\" border=\"0\"></p>\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">Formatted Text</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">具有基本格式选项的文本区域（文本区域的替代方案）</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">Label</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">标准标签字段</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">Button</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">标准按钮</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\"><img src=\"/aras-images/image29.gif\" alt=\"\" style=\"border: none;\" border=\"0\"></p>\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">Radio Button List</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">标准单选按钮组（下拉列表的替代方案）</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\"><img src=\"/aras-images/image37.gif\" alt=\"\" style=\"border: none;\" border=\"0\"></p>\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">Dropdown</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">标准下拉列表</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\"><img src=\"/aras-images/image72.gif\" alt=\"\" style=\"border: none;\" border=\"0\"></p>\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">List box Single Select</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">带滚动条的标准列表框（下拉列表的替代方案）</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\"><img src=\"/aras-images/image503.gif\" alt=\"\" style=\"border: none;\" border=\"0\"></p>\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">List box Multi Select</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">支持多选的带滚动条标准列表框</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\"><img src=\"/aras-images/image498.gif\" alt=\"\" style=\"border: none;\" border=\"0\"></p>\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">Check box List</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">标准复选框组（多选列表的替代方案）</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">Date</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">带有弹出日历用于选择日期的文本字段</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\"><img src=\"/aras-images/image500.gif\" alt=\"\" style=\"border: none;\" border=\"0\"></p>\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">Color</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">带有弹出颜色选择器的字段</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\"><img src=\"/aras-images/image501.gif\" alt=\"\" style=\"border: none;\" border=\"0\"></p>\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">Color List</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">颜色下拉列表</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">HTML</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">可包含自定义 HTML 代码（包括脚本）的字段</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\"><img src=\"/aras-images/image502.gif\" alt=\"\" style=\"border: none;\" border=\"0\"></p>\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">Item</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">带有省略号按钮的文本字段，可用于搜索其他条目</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">File Item</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">允许用户浏览并选择附件文件的字段</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">Class Structure</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">允许用户对条目进行分类的字段</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">Image</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">允许用户选择图像的字段</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">Multilingual String</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">允许用户以不同语言输入多条内容的文本字段</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n\n</td>\n</tr>\n<tr>\n<td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">Group Box</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n<p class=\"Table_Body\" style=\"font-family: Arial, sans-serif;\">用于将其他字段分组的字段</p>\n</td>\n<td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n\n</td>\n</tr>\n</tbody></table>\n\n\n</div></body></html>",
