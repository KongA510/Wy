{
  "title": "表单属性选项卡",
  "html": "<html><head></head><body><div>\n  <h1>表单属性选项卡</h1>\n  <table cellspacing=\"0\" class=\"Aras_Blue\" style=\"border: Solid 1px #c0c0c0; left: 0px; top: 29px;\" width=\"676\">\n    <colgroup>\n      <col style=\"width: 49.733%;\">\n      <col style=\"width: 50.267%;\">\n    </colgroup>\n    <tbody>\n      <tr class=\"t1st\">\n        <td style=\"border: Solid 1px #c0c0c0;\">\n          <p class=\"Table_header\">字段属性</p>\n        </td>\n        <td style=\"border-top: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_header\">表单页面属性</p>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">字段类型</p>\n        </td>\n        <td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">表单属性</p>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">字段标签</p>\n        </td>\n        <td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">表单正文</p>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">字段物理属性</p>\n        </td>\n        <td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">表单事件</p>\n        </td>\n      </tr>\n      <tr>\n        <td style=\"border-left: Solid 1px #c0c0c0; border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\">\n          <p class=\"Table_Body\">字段边框</p>\n        </td>\n        <td style=\"border-right: Solid 1px #c0c0c0; border-bottom: Solid 1px #c0c0c0;\